# Optional Firebase Realtime Database credentials (for multi-device live polling on GitHub Pages)
# Without these, the app runs in Local Multi-Tab Sync mode (BroadcastChannel + localStorage)
# or you can paste them at runtime in the Instructor Console -> Sync Settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional custom instructor passcode (defaults to IMC530 if omitted)
VITE_INSTRUCTOR_PASSCODE=IMC530
